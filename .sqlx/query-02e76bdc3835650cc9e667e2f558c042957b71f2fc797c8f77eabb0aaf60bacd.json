  "query": "\n            SELECT day                AS \"day!\",\n                   COUNT(*)::BIGINT   AS \"active_count!\"\n            FROM user_daily_activity\n            WHERE day >= (NOW() AT TIME ZONE 'UTC')::DATE - INTERVAL '60 days'\n            GROUP BY day\n            ORDER BY day\n            ",
