  "query": "\n            SELECT n.id,\n                   a.full_name AS \"author_name?\",\n                   a.image_url AS \"author_image_url?\",\n                   n.body,\n                   n.created_at\n            FROM user_notes n\n            LEFT JOIN users a ON a.id = n.author_id\n            WHERE n.user_id = $1\n            ORDER BY n.created_at DESC, n.id DESC\n            ",
