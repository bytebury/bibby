  "query": "\n            SELECT me.user_id, COUNT(*) - 1 AS \"others!\"\n            FROM account_group_members me\n            JOIN account_group_members everyone ON everyone.group_id = me.group_id\n            WHERE me.user_id = ANY($1)\n            GROUP BY me.user_id\n            ",
