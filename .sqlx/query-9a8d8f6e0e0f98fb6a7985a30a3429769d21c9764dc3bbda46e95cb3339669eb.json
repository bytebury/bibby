  "db_name": "PostgreSQL",
  "query": "\n            SELECT id,\n                   first_name,\n                   email,\n                   plan_expiry_date AS \"plan_expiry_date!\",\n                   plan_expiry_reminder_days\n              FROM users\n             WHERE plan_expiry_date IS NOT NULL\n               AND plan_expiry_date >= CURRENT_DATE\n               AND plan_expiry_date <= CURRENT_DATE + $1::INT\n               AND role = 'professional'\n            ",
