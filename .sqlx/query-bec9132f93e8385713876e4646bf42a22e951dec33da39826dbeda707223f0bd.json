{
  "db_name": "PostgreSQL",
  "query": "\n            UPDATE one_time_passcodes\n               SET attempts = attempts + 1\n             WHERE id = (SELECT id\n                           FROM one_time_passcodes\n                          WHERE email = $1\n                          ORDER BY created_at DESC, id DESC\n                          LIMIT 1)\n               AND expires_at > NOW()\n               AND attempts < $2\n            RETURNING id, email, code_hash, attempts\n            ",
